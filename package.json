{
  "name": "project-flow",
  "private": true,
  "version": "0.1.1",
  "description": "Local-first desktop project planning for Windows.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false && tsc --noEmit -p tsconfig.e2e.json --pretty false",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:application && npm run test:e2e:native",
    "test:e2e:application": "vitest run --config vitest.e2e.config.ts --reporter=verbose",
    "test:e2e:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:e2e:desktop": "npm run e2e:build && vitest run --config vitest.desktop-e2e.config.ts --reporter=verbose",
    "test:performance": "vitest run --config vitest.performance.config.ts --reporter=verbose",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "e2e:build": "node tests/e2e/build.mjs",
    "tauri:build:test": "tauri build --no-bundle --features shared-dev-data",
    "tauri:build:installer": "tauri build --bundles nsis",
    "tauri:build:installer:offline": "tauri build --bundles nsis --config src-tauri/tauri.offline.conf.json"
  },
  "dependencies": {
    "@svar-ui/react-gantt": "2.7.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-log": "2.9.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-sql": "2.4.0",
    "date-holidays": "3.36.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
