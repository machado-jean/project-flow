{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.desktop-e2e.config.ts",
    "vitest.e2e.config.ts",
    "vitest.performance.config.ts"
  ]
}
